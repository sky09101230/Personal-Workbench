# API
DATABASE_URL=sqlite:///./data/workbench.db
CORS_ORIGINS=http://localhost:5173
WORKBENCH_AGENT_TOKEN=

# Zotero credentials stay on the backend and are never exposed to the browser.
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# Optional OpenAlex backend key. When set, every Works API request uses it.
OPENALEX_API_KEY=

# Optional DeepSeek backend summarization. The key is never exposed to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
